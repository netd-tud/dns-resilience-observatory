POSTGRES_DB=dns_resilience_observatory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=dns_resilience_observatory

DJANGO_SECRET_KEY=django-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=api,frontend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
API_BASE_URL=/

# Public web server. The defaults keep local development on http://localhost:8000.
SERVER_DOMAIN=localhost
HTTP_PORT=8000
HTTPS_PORT=443
CERTBOT_EMAIL=
# letsencrypt, tu-dresden, or custom
CERTBOT_CA=letsencrypt
# Required only for custom; overrides the selected CA's endpoint when set.
CERTBOT_SERVER_URL=
# Optional certificate lineage name; normally derived automatically.
CERTBOT_CERT_NAME=
CERTBOT_STAGING=false
CERTBOT_RENEW_INTERVAL=43200
CERTBOT_RETRY_INTERVAL=300

EXTERNAL_DATA_DIR=/data/external
POLARS_SKIP_CPU_CHECK=1
